# Private key for contract deployment and interactions
PRIVATE_KEY=your_private_key_here

# PostgreSQL database connection string
DATABASE_URL=postgresql://username:password@host:port/database?sslmode=require

# Public base URL for the application
NEXT_PUBLIC_BASE_URL=https://your-domain.com

# zkVerify Configuration (Server-side only for security)
# Add your zkVerify seed phrase here for Volta testnet
# This is kept server-side only to prevent seed phrase exposure in client bundles
# Generate a new seed phrase for zkVerify testnet access
# Example: "word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12"
ZKVERIFY_SEED_PHRASE=your_twelve_word_seed_phrase_here