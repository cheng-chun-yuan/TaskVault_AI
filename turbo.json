{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "ZKVERIFY_SEED_PHRASE",
        "RECLAIM_APPLICATION_ID",
        "RECLAIM_APPLICATION_SECRET",
        "RECLAIM_PROVIDER_ID"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "ZKVERIFY_SEED_PHRASE",
        "RECLAIM_APPLICATION_ID",
        "RECLAIM_APPLICATION_SECRET",
        "RECLAIM_PROVIDER_ID"
      ]
    }
  }
}
